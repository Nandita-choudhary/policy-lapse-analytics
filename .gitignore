# Secrets — never commit these
.env
.env.*
*.pem
# ...except the template, which holds only a placeholder password
!.env.example

# Generated data — the script rebuilds it; only the sample is committed
data/*.csv
!data/sample/*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Power BI local cache
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf
*.pbix

# OS
.DS_Store
Thumbs.db
