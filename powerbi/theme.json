        "labels": [
          {
            "color": { "solid": { "color": "#52514E" } },
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          { "color": { "solid": { "color": "#F9F9F7" } }, "transparency": 0 }
        ],
        "outspace": [
          { "color": { "solid": { "color": "#F9F9F7" } }, "transparency": 0 }
