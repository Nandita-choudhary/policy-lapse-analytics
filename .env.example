# Copy this file to .env and fill in your own value.
#   cp .env.example .env
#
# .env is gitignored and must stay that way — this connection string is a password.
#
# Where to find it: supabase.com → your project → Project Settings → Database →
# Connection string → URI.  Replace [YOUR-PASSWORD] with the database password you
# set when you created the project.

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
